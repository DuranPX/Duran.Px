---
import ProjectCard from "../../components/projects/ProjectCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { projects } from "../../data/projects";
---

<SiteLayout
  currentPath="/projects/"
  title="Proyectos — Juan Durán"
  description="Proyectos de backend y desarrollo full-stack, con su alcance y estado descritos con claridad."
>
  <section class="page-hero section-wrap">
    <p class="eyebrow mono">ÍNDICE / PROYECTOS</p>
    <h1>Trabajo en contexto, <span>no solo una lista de tecnologías.</span></h1>
    <p class="page-intro">
      Una selección de proyectos y exploraciones. Los estados y aportes que aún
      no he podido verificar están señalados como pendientes de confirmación.
    </p>
  </section>
  <section class="section-block section-wrap projects-page-list" aria-label="Listado de proyectos">
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>
</SiteLayout>
