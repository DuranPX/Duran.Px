---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { projects, getProjectStatusLabel } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<SiteLayout
  currentPath="/projects/"
  title={`${project.name} — Proyectos de Juan Durán`}
  description={project.summary}
>
  <article class="project-detail section-wrap">
    <a class="back-link mono" href="/projects/">← VOLVER A PROYECTOS</a>
    <header class="project-detail-header">
      <p class="eyebrow mono">{project.eyebrow}</p>
      <div class="detail-title-row">
        <h1>{project.name}</h1>
        <span class={`status-pill status-${project.status}`}>{getProjectStatusLabel(project.status)}</span>
      </div>
      <p class="project-detail-summary">{project.summary}</p>
    </header>

    <div class="detail-content-grid">
      <div class="detail-main">
        <section class="detail-section">
          <p class="eyebrow mono">CONTEXTO</p>
          <h2>Qué busca resolver</h2>
          <p>{project.description}</p>
        </section>
        <section class="detail-section">
          <p class="eyebrow mono">ÁREAS DE INTERÉS</p>
          <h2>Lo que explora</h2>
          <ul class="detail-list">
            {project.focus.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="detail-section pending-section">
          <p class="eyebrow mono">ANTES DE PUBLICAR COMO CASO DE ESTUDIO</p>
          <h2>Por confirmar</h2>
          <ul class="detail-list">
            {project.pending.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>
      <aside class="detail-sidebar">
        <div class="detail-meta-card">
          <p class="mono">ESTADO</p>
          <span class={`status-pill status-${project.status}`}>{project.statusLabel}</span>
        </div>
        <div class="detail-meta-card">
          <p class="mono">TECNOLOGÍAS DESCRITAS</p>
          {
            project.technologies.length > 0 ? (
              <ul class="tag-list detail-tags">
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            ) : (
              <p>Stack por confirmar.</p>
            )
          }
        </div>
        <div class="detail-meta-card detail-note">
          <p class="mono">NOTA</p>
          <p>
            No se presenta una demo, despliegue o contribución individual que
            no haya sido confirmada.
          </p>
        </div>
      </aside>
    </div>
  </article>
</SiteLayout>
