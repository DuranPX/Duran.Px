---
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  developingKnowledge,
  practicalSkills,
  siteConfig,
} from "../data/site";
---

<SiteLayout
  currentPath="/about/"
  title="Perfil — Juan Durán"
  description="Perfil, formación, experiencia práctica y áreas de aprendizaje de Juan Durán."
>
  <section class="page-hero section-wrap">
    <p class="eyebrow mono">PERFIL / JUAN DURÁN</p>
    <h1>Entender el sistema <span>de punta a punta.</span></h1>
    <p class="page-intro">{siteConfig.biography}</p>
  </section>

  <section class="section-block section-wrap about-page-grid">
    <div class="profile-column">
      <p class="eyebrow mono">FORMACIÓN</p>
      <h2>Un recorrido en construcción.</h2>
      <div class="education-card">
        <span class="education-index mono">01</span>
        <div>
          <h3>Universidad de Caldas</h3>
          <p>Estudiante de Ingeniería.</p>
          <span class="pending-note">Nombre oficial del programa y fechas por confirmar.</span>
        </div>
      </div>
      <div class="education-card">
        <span class="education-index mono">02</span>
        <div>
          <h3>Google Cloud Computing Foundations</h3>
          <p>Certificado y ocho skill badges reportados para mayo de 2026.</p>
          <span class="pending-note">Nombre oficial y enlaces a credenciales por confirmar.</span>
        </div>
      </div>
      <div class="education-card">
        <span class="education-index mono">03</span>
        <div>
          <h3>IA sin límites</h3>
          <p>Ruta de aprendizaje asociada a la Alcaldía de Medellín.</p>
          <span class="pending-note">Tipo de formación y estado por confirmar.</span>
        </div>
      </div>
    </div>

    <div class="profile-column">
      <p class="eyebrow mono">CÓMO APRENDO</p>
      <h2>Desde las responsabilidades y los datos.</h2>
      <p class="profile-copy">
        Me interesa comprender cómo se conectan las reglas de negocio, los
        servicios, los datos y la experiencia que recibe una persona. Sigo
        fortaleciendo mis conocimientos con proyectos académicos y personales.
      </p>
      <ul class="detail-list">
        {developingKnowledge.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-block section-wrap skills-section" aria-labelledby="practice-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow mono">HERRAMIENTAS</p>
        <h2 id="practice-heading">Experiencia práctica en proyectos.</h2>
      </div>
      <p class="section-aside">Tecnologías descritas junto a proyectos, no puntuaciones.</p>
    </div>
    <div class="skill-columns profile-skills">
      {practicalSkills.map((group) => (
        <div class="skill-group">
          <h3>{group.category}</h3>
          <ul class="skill-cloud">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</SiteLayout>
