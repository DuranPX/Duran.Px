---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import ProjectArticle from "../components/ProjectArticle.astro";
import Icon from "../components/Icon.astro";
import Todo from "../components/Todo.astro";
import T from "../components/T.astro";
import { profile, contextFacts, about, approach } from "../data/profile";
import { projects, archive } from "../data/projects";
import { credentials, experience } from "../data/credentials";
import { technologyGroups, iconUrl } from "../data/technologies";
import { attr, ui } from "../i18n";
import {
  aboutEn,
  approachEn,
  archiveEn,
  contextFactsEn,
  credentialsEn,
  kindEn,
  statusEn,
  techEn,
} from "../i18n/en";

const year = new Date().getFullYear();
const roman = ["I", "II", "III", "IV"];
const verifiedExperience = experience.filter((e) => e.verified);
const newTab = (name: string) => attr("aria-label", `${name} (${ui.newTab.es})`, `${name} (${ui.newTab.en})`);
---

<MainLayout>
  <SiteHeader />
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <main id="contenido">
    <Hero />

    <!-- Franja de contexto -->
    <section class="facts" {...attr("aria-label", ui.summary.es, ui.summary.en)}>
      <dl class="wrap facts__list rail">
        {contextFacts.map((f, i) => (
          <div class="facts__item">
            <dt class="meta"><T es={f.label} en={contextFactsEn[i]?.label} /></dt>
            <dd><T es={f.value} en={contextFactsEn[i]?.value} /></dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- II. Proyectos -->
    <section class="section" id="proyectos" aria-labelledby="proyectos-title">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <span class="section-head__num" aria-hidden="true">II</span>
          <h2 class="section-head__title" id="proyectos-title"><T {...ui.projectsTitle} /></h2>
          <p class="section-head__lead"><T {...ui.projectsLead} /></p>
        </header>

        <nav {...attr("aria-label", ui.projectIndex.es, ui.projectIndex.en)}>
          <ol class="project-index rail" data-reveal>
            {projects.map((p, i) => (
              <li>
                <a href={`#proyecto-${p.id}`}>
                  <span class="meta">{roman[i]} · <T es={p.status} en={statusEn[p.status]} /></span>
                  <span class="project-index__title">{p.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        {projects.map((project, index) => <ProjectArticle project={project} index={index} />)}

        <details class="archive details" data-reveal>
          <summary class="archive__head">
            <h3 class="archive__title"><T {...ui.otherProjects} /> <span class="archive__count meta">+{archive.length}</span></h3>
            <span class="details__icon" aria-hidden="true"></span>
          </summary>
          <ul class="archive__list">
            {archive.map((r) => (
              <li class="archive__row">
                <span class="meta">{r.year}</span>
                <span class="archive__name">
                  {r.url ? (
                    <a href={r.url} target="_blank" rel="noopener noreferrer">{r.title}<span class="sr-only"> (<T {...ui.githubRepo} />)</span></a>
                  ) : r.title}
                </span>
                <span class="archive__desc"><T es={r.description} en={archiveEn[r.title]} /></span>
                <span class="archive__stack meta">{r.stack}</span>
                <span class="archive__go" aria-hidden="true">{r.url ? <Icon name="arrow" /> : <span class="meta"><T {...ui.private} /></span>}</span>
              </li>
            ))}
          </ul>
          <p class="archive__more">
            <a class="link-line ext" href={profile.github} target="_blank" rel="noopener noreferrer"><T {...ui.allRepos} /></a>
          </p>
        </details>
      </div>
    </section>

    <!-- III. Perfil -->
    <section class="section section--alt" id="perfil" aria-labelledby="perfil-title">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <span class="section-head__num" aria-hidden="true">III</span>
          <h2 class="section-head__title" id="perfil-title"><T {...ui.profileTitle} /></h2>
        </header>

        <div class="profile">
          <p class="profile__quote italic" data-reveal><T {...ui.quote} /></p>

          <div class="profile__body" data-reveal style="--delay:.1s">
            {about.paragraphs.map((p, i) => <p><T es={p} en={aboutEn.paragraphs[i]} /></p>)}

            <div class="profile__aside rail">
              <div>
                <h3><T {...ui.learning} /></h3>
                <ul>{about.learning.map((l, i) => <li><T es={l} en={aboutEn.learning[i]} /></li>)}</ul>
              </div>
              <div>
                <h3><T {...ui.offCode} /></h3>
                <p><T es={about.personal} en={aboutEn.personal} /></p>
              </div>
            </div>
          </div>
        </div>

        <ol class="approach rail" {...attr("aria-label", ui.approachLabel.es, ui.approachLabel.en)}>
          {approach.map((step, i) => (
            <li data-reveal style={`--delay:${i * 0.08}s`}>
              <span class="approach__num" aria-hidden="true">{roman[i]}</span>
              <h3><T es={step.title} en={approachEn[i]?.title} /></h3>
              <p><T es={step.text} en={approachEn[i]?.text} /></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- IV. Formación -->
    <section class="section" id="formacion" aria-labelledby="formacion-title">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <span class="section-head__num" aria-hidden="true">IV</span>
          <h2 class="section-head__title" id="formacion-title"><T {...ui.educationTitle} /></h2>
        </header>

        <div class="creds">
          <ul class="creds__list">
            {credentials.map((c) => {
              const en = credentialsEn[c.title];
              return (
                <li class="cred" data-reveal data-current={c.date === "Actualidad" ? "" : undefined}>
                  <div>
                    <p class="cred__when meta">
                      {c.date ? <T es={c.date} en={en?.date} /> : <Todo label="fecha" />}<span aria-hidden="true"> · </span><T es={c.kind} en={kindEn[c.kind]} />
                    </p>
                    <h3 class="cred__title"><T es={c.title} en={en?.title} /></h3>
                    <p class="cred__issuer">{c.issuer}</p>
                    {c.note && <p class="cred__note"><T es={c.note} en={en?.note} /></p>}
                  </div>
                  <div class="cred__right">
                    {c.url && (
                      <a class="link-line ext" href={c.url} target="_blank" rel="noopener noreferrer"><T {...(c.kind === "Formación" ? ui.viewProgram : ui.verify)} /><span class="sr-only"> {c.title}</span></a>
                    )}
                  </div>
                </li>
              );
            })}
            {verifiedExperience.map((e) => (
              <li class="cred" data-reveal>
                <div>
                  <p class="cred__when meta">{e.period}<span aria-hidden="true"> · </span><T {...ui.experience} /></p>
                  <h3 class="cred__title">{e.role}</h3>
                  <p class="cred__issuer">{e.organization}</p>
                  <p class="cred__note">{e.description}</p>
                </div>
              </li>
            ))}
          </ul>

          <aside class="badge-card" data-reveal style="--delay:.1s" {...attr("aria-label", ui.badgesLabel.es, ui.badgesLabel.en)}>
            <svg class="badge-card__seal" viewBox="0 0 56 56" fill="none" stroke="currentColor" aria-hidden="true">
              <circle cx="28" cy="24" r="17" />
              <circle cx="28" cy="24" r="12" stroke-opacity=".5" />
              <path d="m20 38-3 15 11-6 11 6-3-15" />
              <path d="m23 24 3.5 3.5L33 21" />
            </svg>
            <h3><T {...ui.badgesTitle} /></h3>
            <p><T {...ui.badgesText} /></p>
            {profile.credly ? (
              <a class="btn" href={profile.credly} target="_blank" rel="noopener noreferrer">
                <T {...ui.credlyProfile} /> <span class="sr-only">(<T {...ui.newTab} />)</span><span class="arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <Todo label="URL de Credly (profile.credly)" />
            )}
          </aside>
        </div>
      </div>
    </section>

    <!-- V. Tecnologías -->
    <section class="section section--alt" id="tecnologias" aria-labelledby="tecnologias-title">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <span class="section-head__num" aria-hidden="true">V</span>
          <h2 class="section-head__title" id="tecnologias-title"><T {...ui.techTitle} /></h2>
          <p class="section-head__lead"><T {...ui.techLead} /></p>
        </header>

        <div class="tech rail">
          {technologyGroups.map((g, i) => (
            <div class="tech__group" data-reveal style={`--delay:${i * 0.08}s`}>
              <h3><T es={g.title} en={techEn[g.title]?.title} /></h3>
              <p><T es={g.description} en={techEn[g.title]?.description} /></p>
              <ul class="tech__items">
                {g.items.map((t) => (
                  <li>
                    {t.icon && <>
                      <img class="icon-dark" src={iconUrl(t.icon, "dark")} alt="" width="30" height="30" loading="lazy" decoding="async" />
                      <img class="icon-light" src={iconUrl(t.icon, "light")} alt="" width="30" height="30" loading="lazy" decoding="async" />
                    </>}
                    {t.name}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- VI. Contacto -->
    <section class="section contact" id="contacto" aria-labelledby="contacto-title">
      <div class="contact__glow" aria-hidden="true"></div>
      <div class="wrap">
        <p class="meta" data-reveal><T {...ui.contactKicker} /></p>
        <h2 class="contact__title" id="contacto-title" data-reveal><T {...ui.contactTitle} /><em class="italic">?</em></h2>
        <p class="contact__lead" data-reveal><T {...ui.contactLead} /></p>

        <div class="contact__mail" data-reveal>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <button class="btn copy-btn" type="button" data-copy={profile.email} hidden><T {...ui.copyEmail} /></button>
        </div>

        <ul class="contact__links" data-reveal>
          <li><a class="link-line ext" href={profile.linkedin} target="_blank" rel="noopener noreferrer" {...newTab("LinkedIn")}>LinkedIn</a></li>
          <li><a class="link-line ext" href={profile.github} target="_blank" rel="noopener noreferrer" {...newTab("GitHub")}>GitHub</a></li>
          {profile.credly ? (
            <li><a class="link-line ext" href={profile.credly} target="_blank" rel="noopener noreferrer" {...newTab("Credly")}>Credly</a></li>
          ) : (
            <li><Todo label="Credly" /></li>
          )}
          {profile.cv.available ? (
            <li><a class="link-line" href={profile.cv.file} download><T {...ui.downloadCv} /></a></li>
          ) : (
            <li>
              <a class="link-line" href={`mailto:${profile.email}?subject=${encodeURIComponent(ui.requestCvSubject.es)}`} data-l="es">{ui.requestCv.es}</a>
              <a class="link-line" href={`mailto:${profile.email}?subject=${encodeURIComponent(ui.requestCvSubject.en)}`} data-l="en" lang="en">{ui.requestCv.en}</a>
            </li>
          )}
          <li class="meta" style="align-self:center">{profile.location}</li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <p class="meta">© {year} {profile.name} · {profile.handle}</p>
      <nav {...attr("aria-label", ui.footerLinks.es, ui.footerLinks.en)}>
        <ul>
          <li><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={`mailto:${profile.email}`}><T {...ui.email} /></a></li>
          <li><a href="#inicio"><T {...ui.backToTop} /> ↑</a></li>
        </ul>
      </nav>
    </div>
  </footer>

  <a class="to-top" href="#inicio" {...attr("aria-label", ui.backToTop.es, ui.backToTop.en)} data-to-top><Icon name="up" /></a>
</MainLayout>

<script>
  import { ui } from "../i18n";

  const root = document.documentElement;
  const lang = () => (root.dataset.lang === "en" ? "en" : "es");

  // ---------- Idioma ----------
  const titleEs = document.title;
  const titleEn = document.querySelector<HTMLMetaElement>('meta[name="title-en"]')?.content ?? titleEs;
  const ATTRS = ["aria-label", "alt", "title"] as const;

  const applyLang = (next: "es" | "en") => {
    root.dataset.lang = next;
    root.lang = next === "en" ? "en" : "es-CO";
    document.title = next === "en" ? titleEn : titleEs;
    for (const name of ATTRS) {
      document.querySelectorAll<HTMLElement>(`[data-en-${name}]`).forEach((el) => {
        if (!el.hasAttribute(`data-es-${name}`)) el.setAttribute(`data-es-${name}`, el.getAttribute(name) ?? "");
        el.setAttribute(name, el.getAttribute(`data-${next}-${name}`) ?? "");
      });
    }
    syncThemeLabel();
    document.dispatchEvent(new CustomEvent("langchange"));
  };

  document.querySelector("[data-lang-toggle]")?.addEventListener("click", () => {
    const next = lang() === "en" ? "es" : "en";
    try { localStorage.setItem("lang", next); } catch { /* sin almacenamiento */ }
    applyLang(next);
  });

  // ---------- Tema claro / oscuro ----------
  const themeBtn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  function syncThemeLabel() {
    const light = root.dataset.theme === "light";
    themeBtn?.setAttribute("aria-label", (light ? ui.themeToDark : ui.themeToLight)[lang()]);
  }
  themeBtn?.addEventListener("click", () => {
    const next = root.dataset.theme === "light" ? "dark" : "light";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch { /* sin almacenamiento */ }
    syncThemeLabel();
  });

  applyLang(lang());

  // ---------- Header, progreso y volver arriba ----------
  const header = document.querySelector<HTMLElement>("[data-header]");
  const progress = document.querySelector<HTMLElement>("[data-progress]");
  const toTop = document.querySelector<HTMLElement>("[data-to-top]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const compact = matchMedia("(max-width: 860px)");
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    const max = root.scrollHeight - window.innerHeight;
    header?.toggleAttribute("data-scrolled", y > 24);
    // En pantallas pequeñas el header se esconde al bajar y vuelve al subir
    const menuOpen = toggle?.getAttribute("aria-expanded") === "true";
    header?.toggleAttribute("data-hidden", compact.matches && !menuOpen && y > 240 && y > lastY + 4);
    if (y < lastY - 4 || y < 240) header?.removeAttribute("data-hidden");
    lastY = y;
    toTop?.toggleAttribute("data-visible", y > window.innerHeight * 0.8);
    if (progress) progress.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max) : 0})`;
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // ---------- Menú móvil ----------
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const setMenu = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    nav?.toggleAttribute("data-open", open);
  };
  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  nav?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      toggle.focus();
    }
  });

  // ---------- Sección actual ----------
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>("[data-nav-link]").forEach((l) => links.set(l.dataset.navLink!, l));
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((l) => l.removeAttribute("aria-current"));
        links.get(entry.target.id)?.setAttribute("aria-current", "true");
      });
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) spy.observe(el);
  });

  // ---------- Aparición progresiva ----------
  const reveal = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.setAttribute("data-visible", "");
          obs.unobserve(entry.target);
        }
      });
    },
    { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => reveal.observe(el));

  // ---------- Carruseles ----------
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>(".carousel__track")!;
    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length < 2) return;
    carousel.setAttribute("data-ready", "");
    const prev = carousel.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = carousel.querySelector<HTMLButtonElement>("[data-next]")!;
    const count = carousel.querySelector<HTMLElement>("[data-count]")!;
    const caption = carousel.querySelector<HTMLElement>("[data-caption-out]")!;
    const dots = carousel.querySelectorAll<HTMLElement>(".carousel__dots span");
    let current = 0;

    const renderCaption = () => {
      const s = slides[current];
      caption.textContent = (lang() === "en" ? s.dataset.captionEn : s.dataset.caption) ?? "";
    };
    const update = (i: number) => {
      current = i;
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
      count.textContent = `${i + 1} / ${slides.length}`;
      renderCaption();
      dots.forEach((d, j) => d.toggleAttribute("data-active", j === i));
    };
    const go = (i: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, i));
      update(target);
      track.scrollTo({ left: slides[target].offsetLeft - slides[0].offsetLeft });
    };
    prev.addEventListener("click", () => go(current - 1));
    next.addEventListener("click", () => go(current + 1));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(current + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); go(current - 1); }
    });
    const step = () => slides[1].offsetLeft - slides[0].offsetLeft;
    const sync = () => {
      const i = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / step())));
      if (i !== current) update(i);
    };
    track.addEventListener("scrollend", sync, { passive: true });
    track.addEventListener("pointerup", () => setTimeout(sync, 450), { passive: true });
    document.addEventListener("langchange", renderCaption);
  });

  // ---------- Copiar correo ----------
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    const original = btn.innerHTML;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = ui.copied[lang()];
        setTimeout(() => (btn.innerHTML = original), 2200);
      } catch {
        /* sin permiso de portapapeles: el enlace mailto sigue disponible */
      }
    });
  });
</script>
