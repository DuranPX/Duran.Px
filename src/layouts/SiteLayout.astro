---
import { ClientRouter } from "astro:transitions";
import SiteFooter from "../components/navigation/SiteFooter.astro";
import SiteHeader from "../components/navigation/SiteHeader.astro";
import { siteConfig } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = `${siteConfig.name} — Backend & Full-Stack`,
  description = siteConfig.description,
  currentPath = Astro.url.pathname,
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site
  ? new URL("/social-card.svg", Astro.site).href
  : "/social-card.svg";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080d19" />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Identidad visual del portafolio de Juan Durán" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: siteConfig.name,
      jobTitle: siteConfig.role,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Manizales",
        addressRegion: "Caldas",
        addressCountry: "CO",
      },
      email: `mailto:${siteConfig.email}`,
      sameAs: [siteConfig.github, siteConfig.linkedin],
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <div class="site-shell">
      <SiteHeader currentPath={currentPath} />
      <main id="main-content">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
