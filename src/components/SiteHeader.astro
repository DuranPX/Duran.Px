---
import { profile } from "../data/profile";
import { attr, ui } from "../i18n";
import T from "./T.astro";

const sections = [
  { id: "inicio", label: ui.nav.inicio },
  { id: "proyectos", label: ui.nav.proyectos },
  { id: "perfil", label: ui.nav.perfil },
  { id: "formacion", label: ui.nav.formacion },
  { id: "tecnologias", label: ui.nav.tecnologias },
  { id: "contacto", label: ui.nav.contacto },
];
---

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a
      class="brand"
      href="#inicio"
      {...attr("aria-label", `${profile.name} (${profile.handle}), ${ui.home.es}`, `${profile.name} (${profile.handle}), ${ui.home.en}`)}
    >
      <span class="brand__mark" aria-hidden="true">{profile.monogram}</span>
      <span class="brand__name" aria-hidden="true">Duran<em class="italic">Px</em></span>
    </a>

    <div class="header-actions">
      <nav class="nav" id="site-nav" {...attr("aria-label", ui.sections.es, ui.sections.en)} data-nav>
        <ul class="nav__list">
          {sections.map((s) => (
            <li><a class="nav__link" href={`#${s.id}`} data-nav-link={s.id}><T {...s.label} /></a></li>
          ))}
        </ul>
      </nav>

      <button class="lang-toggle" type="button" data-lang-toggle {...attr("aria-label", ui.langSwitch.es, ui.langSwitch.en)}>
        <span data-l="es" aria-hidden="true">EN</span><span data-l="en" aria-hidden="true">ES</span>
      </button>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label={ui.themeToLight.es}>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
        <span class="nav-toggle__label"><T {...ui.menu} /></span>
        <span class="nav-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
