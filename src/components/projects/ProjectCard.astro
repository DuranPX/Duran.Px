---
import type { Project } from "../../data/projects";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<article class="project-card">
  <div class="project-card-top">
    <span class="mono project-number">{number} / PROYECTO</span>
    <span class={`status-pill status-${project.status}`}>{project.statusLabel}</span>
  </div>
  <p class="project-eyebrow">{project.eyebrow}</p>
  <h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3>
  <p class="project-summary">{project.summary}</p>
  <div class="project-card-bottom">
    <ul class="tag-list" aria-label={`Tecnologías de ${project.name}`}>
      {
        project.technologies.slice(0, 3).map((technology) => (
          <li>{technology}</li>
        ))
      }
      {project.technologies.length === 0 && <li>Stack por confirmar</li>}
    </ul>
    <a
      class="text-link"
      href={`/projects/${project.slug}/`}
      aria-label={`Leer sobre ${project.name}`}
    >
      Explorar <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
